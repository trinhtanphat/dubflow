{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dubflow",
  "account_id": "6c5207813df3d5b83b9508125e0e9e12",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "yupvox.qs3d.site", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "binding": "DUBBING_WORKFLOW",
      "name": "dubflow-dubbing",
      "class_name": "DubbingWorkflow"
    }
  ],
  "containers": [
    {
      "class_name": "FfmpegContainer",
      "image": "./containers/ffmpeg/Dockerfile",
      "max_instances": 4,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FFMPEG_CONTAINER", "class_name": "FfmpegContainer" }
    ]
  },
  "exports": {
    "FfmpegContainer": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
