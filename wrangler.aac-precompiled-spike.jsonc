{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dubflow-aac-precompiled-spike",
  "main": "worker/src/spikes/aac-precompiled-worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ]
}
